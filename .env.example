# WasteWatch v7.0 — Environment Variables
#
# ═══════════════════════════════════════════════════════════
#  🎮 DEMO MODE (Zero Config)
# ═══════════════════════════════════════════════════════════
# The app works OUT OF THE BOX without any API keys!
# When FAST2SMS_KEY is not set, Demo Mode auto-activates:
#   → Demo account pre-seeded:  phone: 8989893838  password: demo@123
#   → Universal OTP: 123456 (always accepted for new registrations)
#   → AI features gracefully degrade to rule-based fallbacks
#
# Just run:  pip install -r requirements.txt && uvicorn main:app
# ═══════════════════════════════════════════════════════════

# ── REQUIRED (for full AI features — optional for demo) ──
# Google Gemini AI (for waste analysis, insights, predictions)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend (for anonymous authority email notifications)
RESEND_API_KEY=your_resend_api_key_here
# FROM address — must be verified sender in your Resend account
# Without custom domain: use "onboarding@resend.dev" (sandbox, only delivers to YOUR email)
# With custom domain: use "noreply@yourdomain.com"
RESEND_FROM=WasteWatch <onboarding@resend.dev>

# ── OPTIONAL BUT RECOMMENDED ────────────────────
# Groq Llama-3.3 (automatic fallback when Gemini hits rate limit)
GROQ_API_KEY=your_groq_api_key_here

# Fast2SMS (for OTP delivery on new registrations)
# Without this key: DEMO MODE activates (OTP 123456 always works)
# Get free credits at: https://fast2sms.com
FAST2SMS_KEY=your_fast2sms_key_here

# ── DATABASE ────────────────────────────────────
# Options: "sqlite" (default, local) | "supabase" (production)
DATABASE_MODE=sqlite

# Required only if DATABASE_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
